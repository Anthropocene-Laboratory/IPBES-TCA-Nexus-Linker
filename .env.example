# Copy this file to .env and fill in your Supabase project values.
# Find them in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: shared access code to gate the app (pilot, no-auth mode).
# Leave empty to disable the gate. Note: this ships in the client bundle,
# so it is a soft gate for an unlisted URL, not a real secret.
VITE_ACCESS_CODE=
